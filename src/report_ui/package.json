{
  "name": "jigsaw-sensemaking-generator",
  "version": "0.1.0",
  "description": "Interactive HTML report builder for Python sensemaking pipeline outputs.",
  "type": "module",
  "main": "build.js",
  "bin": {
    "sensemaking-py-report-ui": "bin/cli.js"
  },
  "files": [
    "bin/",
    "build.js",
    "data.js",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "predev": "node bin/cli.js static --outputDir ./output",
    "dev": "node dev.js",
    "static": "node bin/cli.js static",
    "inline": "node bin/cli.js inline",
    "build": "node bin/cli.js inline",
    "preview": "node build.js preview",
    "github": "node build.js github"
  },
  "keywords": [
    "sensemaking"
  ],
  "author": "",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "csvtojson": "^2.0.10",
    "inline-source": "^8.0.3",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "express": "^5.2.1"
  }
}
